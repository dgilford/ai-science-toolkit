url: "https://github.com/dgilford/ai-science-toolkit"
license: MIT
keywords:
  - claude-code
  - scientific-computing
  - climate-science
  - atmospheric-science
  - open-science
  - reviewer-agents
version: 1.1.0
date-released: "2026-07-29"
